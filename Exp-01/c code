#include <stdio.h>
#include <string.h>

int main(void) {
    char s1[100], s2[100], temp[100];
    int ch, choice, i, start, len, flag;
    char *str;

    printf("Enter first string: ");
    scanf("%99s", s1);

    printf("Enter second string: ");
    scanf("%99s", s2);

    while (1) {
        printf("\n\n--- MENU ---\n");
        printf("1. Substring\n");
        printf("2. Palindrome\n");
        printf("3. Compare\n");
        printf("4. Copy\n");
        printf("5. Reverse\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        if (ch == 6) {
            printf("Exiting program.\n");
            return 0;
        }

        switch (ch) {
            case 1:
                printf("Enter string number (1 or 2): ");
                scanf("%d", &choice);

                if (choice == 1)
                    str = s1;
                else if (choice == 2)
                    str = s2;
                else {
                    printf("Invalid string choice.\n");
                    break;
                }

                printf("Enter start index and length: ");
                scanf("%d%d", &start, &len);

                if (start < 0 || len < 0 || start >= (int)strlen(str)) {
                    printf("Invalid start index or length.\n");
                    break;
                }

                printf("Substring: ");

                for (i = start; i < start + len && str[i] != '\0'; i++)
                    printf("%c", str[i]);

                printf("\n");
                break;

            case 2:
                printf("Enter string number (1 or 2): ");
                scanf("%d", &choice);

                if (choice == 1)
                    str = s1;
                else if (choice == 2)
                    str = s2;
                else {
                    printf("Invalid string choice.\n");
                    break;
                }

                len = strlen(str);
                flag = 1;

                for (i = 0; i < len / 2; i++) {
                    if (str[i] != str[len - 1 - i]) {
                        flag = 0;
                        break;
                    }
                }

                if (flag)
                    printf("Palindrome\n");
                else
                    printf("Not Palindrome\n");

                break;

            case 3:
                if (strcmp(s1, s2) == 0)
                    printf("Strings are Equal\n");
                else
                    printf("Strings are Not Equal\n");

                break;

            case 4:
                printf("Enter string number (1 or 2): ");
                scanf("%d", &choice);

                if (choice == 1)
                    strcpy(temp, s1);
                else if (choice == 2)
                    strcpy(temp, s2);
                else {
                    printf("Invalid string choice.\n");
                    break;
                }

                printf("Copied String: %s\n", temp);
                break;

            case 5:
                printf("Enter string number (1 or 2): ");
                scanf("%d", &choice);

                if (choice == 1)
                    str = s1;
                else if (choice == 2)
                    str = s2;
                else {
                    printf("Invalid string choice.\n");
                    break;
                }

                len = strlen(str);

                printf("Reversed String: ");

                for (i = len - 1; i >= 0; i--)
                    printf("%c", str[i]);

                printf("\n");
                break;

            default:
                printf("Invalid choice! Please select a valid option.\n");
        }
    }

    return 0;
}
