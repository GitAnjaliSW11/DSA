#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

struct Node *top = NULL;

void push(int value)
{
    struct Node *newNode;

    newNode = (struct Node *)malloc(sizeof(struct Node));

    if (newNode == NULL)
    {
        printf("Stack Overflow.\n");
        return;
    }

    newNode->data = value;
    newNode->next = top;
    top = newNode;

    printf("Pushed %d to stack.\n", value);
}

void display()
{
    struct Node *temp;

    if (top == NULL)
    {
        printf("Stack is empty!\n");
        return;
    }

    printf("\n\nCurrent Stack (Top to Bottom):\n\n");

    temp = top;

    while (temp != NULL)
    {
        printf("| %d |\n", temp->data);
        temp = temp->next;
    }

    printf("-------\n\n");
}

void pop()
{
    struct Node *temp;

    if (top == NULL)
    {
        printf("\nStack Underflow :c\n");
    }
    else
    {
        temp = top;
        printf("Popped = %d\n", top->data);
        top = top->next;
        free(temp);
    }
}

void peek()
{
    if (top == NULL)
    {
        printf("Stack is empty! Nothing to peek.\n\n");
    }
    else
    {
        printf("Top element is: %d\n\n", top->data);
    }
}

int main()
{
    int choice, value;

    do
    {
        printf("\n========== STACK USING LINKED LIST ==========\n");
        printf("1. Push\n");
        printf("2. Pop\n");
        printf("3. Peek\n");
        printf("4. Display\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("\n--- Initiating Push operation ---\n");
                printf("Enter the element: ");
                scanf("%d", &value);
                push(value);
                display();
                break;

            case 2:
                printf("\n--- Initiating Pop operation ---\n");
                pop();
                printf("\nStack after popping:\n");
                display();
                break;

            case 3:
                printf("\n--- Initiating Peek operation ---\n");
                peek();
                break;

            case 4:
                display();
                break;

            case 5:
                printf("Exiting program. Goodbye!\n");
                break;

            default:
                printf("Invalid choice! Please try again.\n");
        }

    } while (choice != 5);

    return 0;
}
