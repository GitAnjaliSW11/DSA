#include <stdio.h> 
#include <ctype.h> 
#define MAX 100 
int main(void) { 
 char expr[MAX]; 
 int stack[MAX], top = -1; 
 printf("Enter postfix expression (single-digit operands): ");  if (scanf("%99s", expr) != 1) return 1; 
 for (int i = 0; expr[i] != '\0'; i++) { 
 char ch = expr[i]; 
 if (isdigit((unsigned char)ch)) { 
 stack[++top] = ch - '0'; 
 } else if (ch == '+' || ch == '-' || ch == '*' || ch == '/') {  if (top < 1) { 
 printf("Invalid postfix expression.\n");  return 1; 
 } 
 int b = stack[top--]; 
 int a = stack[top--]; 
 int result; 
 if (ch == '+') result = a + b; 
 else if (ch == '-') result = a - b; 
 else if (ch == '*') result = a * b; 
 else { 
 if (b == 0) { 
 printf("Division by zero.\n"); 
 return 1; 
 } 
 result = a / b; 
 } 
 stack[++top] = result; 
 } else { 
 printf("Invalid character: %c\n", ch); 
 return 1; 
 } 
 if (top >= MAX - 1) { 
 printf("Expression too long.\n"); 
 return 1; 
 } 
 } 
 if (top != 0) { 
 printf("Invalid postfix expression.\n"); 
 return 1; 
 } 
 printf("Result = %d\n", stack[top]); 
 return 0; 
}
